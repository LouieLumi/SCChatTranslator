<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE4EE"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#F0F4FA"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,16,0,7"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#202830"/><Setter Property="Foreground" Value="#EEF4FA"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#3A4855"/><Setter Property="Padding" Value="9,6"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#202830"/><Setter Property="Foreground" Value="#EEF4FA"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#3A4855"/><Setter Property="Padding" Value="9,6"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E9F2F6"/><Setter Property="Background" Value="#283740"/><Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#3C515C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EEF4FA"/><Setter Property="Padding" Value="9,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="I" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="I" Property="Background" Value="#3C545B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="I" Property="Background" Value="#294A50"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#EEF4FA"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#202830" BorderBrush="#3A4855" BorderThickness="1" CornerRadius="6"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="#DCE4EE" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter x:Name="Selected" Margin="10,5,32,5" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="#202830" BorderThickness="0" Margin="3,2,29,2" Padding="7,3"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#192229" BorderBrush="#40515F" BorderThickness="1" Padding="4" CornerRadius="7" Margin="0,3,0,0" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="Selected" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClearRepeat" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="Transparent" Margin="1,4">
     <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ClearRepeat}"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb">
       <Border x:Name="Pill" Background="#60A5B1BC" CornerRadius="3"/>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#BA90E5D5"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Pill" Property="Background" Value="#D090E5D5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ClearRepeat}"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Grid.Resources>
 <Border Background="#141C23" BorderBrush="#3A4957" BorderThickness="1" CornerRadius="12"/>
 <Grid Margin="22,16,22,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,0,12"><TextBlock Text="设置" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="Cancel" Content="×" FontSize="18" Padding="10,2" HorizontalAlignment="Right" Background="Transparent" ToolTip="关闭设置"/></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
   <TextBlock Text="聊天频道" Style="{StaticResource Label}" Margin="0,2,0,7"/>
   <ComboBox x:Name="Channels" AutomationProperties.Name="聊天频道"/>
   <TextBlock Text="自动跟随当前角色已加入的服务器；有多个频道时可手动选择。" FontSize="11" Foreground="#889DAF" Margin="0,7,0,0"/>
   <TextBlock Text="翻译模型" Style="{StaticResource Label}"/>
   <ComboBox x:Name="Mode" AutomationProperties.Name="翻译模型"><ComboBoxItem Content="Argos 英译中 · Windows 本地（默认）" Tag="argos"/><ComboBoxItem Content="Hy-MT3 1.8B · Windows 本地" Tag="hy_local"/><ComboBoxItem Content="自定义翻译 API · Mac / 其他服务" Tag="api"/></ComboBox>
   <TextBlock x:Name="GlossaryInfo" Text="已启用星际公民中英术语库" FontSize="11" Foreground="#87BCAE" Margin="0,7,0,0"/>
   <TextBlock x:Name="ArgosInfo" Text="已内置，直接使用。无需联网下载，不占用游戏显存。" FontSize="12" Foreground="#91A8B9" Margin="0,9,0,0"/>
   <StackPanel x:Name="HyPanel" Visibility="Collapsed" Margin="0,9,0,0"><TextBlock Text="首次启用会下载约 1.35 GB 模型和约 25 MB 运行组件，之后可离线使用。使用 CPU、2 个推理线程。" FontSize="12" Foreground="#91A8B9"/><TextBlock Text="准备期间使用 Argos；切换模型或关闭窗口时停止 Hy 后台进程。" FontSize="12" Foreground="#91A8B9" Margin="0,5,0,0"/></StackPanel>
   <StackPanel x:Name="ApiPanel" Visibility="Collapsed">
    <TextBlock Text="API 地址" Style="{StaticResource Label}"/><TextBox x:Name="Endpoint" AutomationProperties.Name="API 地址"/>
    <TextBlock Text="支持兼容 Chat Completions 的接口，可填写 /v1 或完整地址。" FontSize="11" Foreground="#889DAF" Margin="0,6,0,0"/>
    <TextBlock Text="API 密钥（接口无需认证时可留空）" Style="{StaticResource Label}"/><PasswordBox x:Name="ApiKey" AutomationProperties.Name="API 密钥"/>
    <TextBlock Text="API 模型" Style="{StaticResource Label}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ApiModel" IsEditable="True" AutomationProperties.Name="API 模型"/><Button x:Name="FetchModels" Grid.Column="1" Content="获取模型" Margin="8,0,0,0"/></Grid>
    <Button x:Name="TestApi" Content="测试翻译连接" HorizontalAlignment="Left" Margin="0,10,0,0"/>
   </StackPanel>
   <CheckBox x:Name="GameHotkeys" Content="F12 状态确认 / 回车输入" Foreground="#E6EDF3" FontSize="13" Margin="0,16,0,6"/>
   <ComboBox x:Name="NativeChatState" AutomationProperties.Name="原生聊天框当前状态">
    <ComboBoxItem Content="状态未知 · 不接管回车"/><ComboBoxItem Content="原生聊天框当前显示"/><ComboBoxItem Content="原生聊天框当前隐藏"/>
   </ComboBox>
   <TextBlock Text="每次在游戏前台按 F12 后询问“已隐藏 / 仍显示”。确认隐藏后回车进入本输入框，再按回车发送；确认仍显示或尚未选择时，回车保留游戏原生行为。" TextWrapping="Wrap" FontSize="11" Foreground="#889DAF" Margin="0,6,0,0"/>
   <CheckBox x:Name="ShowOriginal" Content="显示原文（关闭后只显示译文）" Foreground="#E6EDF3" FontSize="13" Margin="0,16,0,0"/>
   <Grid Margin="0,16,0,7"><TextBlock Text="背景透明度" FontSize="13"/><TextBlock x:Name="AlphaValue" HorizontalAlignment="Right" Foreground="#A5F1DF"/></Grid>
   <Slider x:Name="Transparency" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Height="24" AutomationProperties.Name="背景透明度" ToolTip="只调整背景，文字保持清晰">
    <Slider.Template><ControlTemplate TargetType="Slider"><Grid Background="Transparent"><Border Height="4" Background="#34464F" CornerRadius="2" VerticalAlignment="Center"/><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#94E6D1" Stroke="#D8FFF4" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/></Track.IncreaseRepeatButton>
    </Track></Grid></ControlTemplate></Slider.Template>
   </Slider>
   <Grid><TextBlock Text="不透明" FontSize="10" Foreground="#889DAF"/><TextBlock Text="全透明" FontSize="10" Foreground="#889DAF" HorizontalAlignment="Right"/></Grid>
   <TextBlock Text="游戏 LIVE 目录" Style="{StaticResource Label}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GameDir" AutomationProperties.Name="游戏目录"/><Button x:Name="Browse" Grid.Column="1" Content="选择" Margin="8,0,0,0"/></Grid>
   <TextBlock Text="自动寻找已运行的游戏；也可选择 LIVE 中的 loginData.json 或 Bin64 中的 StarCitizen.exe。" FontSize="11" Foreground="#889DAF" Margin="0,7,0,0"/>
   <TextBlock x:Name="Feedback" Foreground="#A5F1DF" Margin="0,14,0,8" FontSize="12"/>
  </StackPanel></ScrollViewer>
  <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="EngineStatus" FontSize="11" Foreground="#8EA1B0" VerticalAlignment="Center" Margin="0,0,14,0"/><Button x:Name="Save" Grid.Column="1" Content="保存并应用" Background="#24544E"/></Grid>
 </Grid>
</Grid>
